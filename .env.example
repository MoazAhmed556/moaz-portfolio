# Environment variables — all OPTIONAL. The site needs no API keys or secrets.
#
# To use one locally, copy this file to `.env.local` and fill it in.
# On Vercel, add it under Project → Settings → Environment Variables.

# The public address of the site, used for the canonical link, Open Graph images and the sitemap.
# On Vercel this is filled in automatically from your production domain (VERCEL_PROJECT_PRODUCTION_URL),
# so you only need it for another host, or to force a custom domain.
NEXT_PUBLIC_SITE_URL=https://www.example.com
